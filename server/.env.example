# Copy file này thành .env rồi dán chuỗi kết nối Neon của bạn.
# Có thể dán nguyên chuỗi từ Neon (kể cả channel_binding) — server tự bỏ tham số này.
# Host direct (không "-pooler") hoặc pooled đều chạy được.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
PORT=8787

# Cloudinary Upload API (lấy ở Cloudinary Console → API Keys).
# Chỉ đặt ở server, KHÔNG nhúng vào app Flutter.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP gửi mã xác nhận OTP (bật Xác minh 2 bước và tạo Mật khẩu ứng dụng 16 ký tự)
SMTP_EMAIL=kietphan4444@gmail.com
SMTP_PASSWORD=ptmi bnyz mvhk meig
