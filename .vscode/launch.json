            "args": [
                "--dart-define=API_BASE_URL=https://tiktube-api.onrender.com"
            ]
        },
        {
            "name": "TIKTUBE (Edge Web)",
            "request": "launch",
            "type": "dart",
            "deviceId": "edge",
            "args": [
                "--dart-define=API_BASE_URL=https://tiktube-api.onrender.com"
            ]
        }
    ]
}
